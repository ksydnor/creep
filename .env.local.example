# Copy to .env.local for local development. On the server these values live in
# .env (see .env.production.example).
# .env.local is the one file both `next dev` and `payload run` (npm run seed) read,
# so seeding uses the same secret and database path the site does.

# Long random string used to sign login sessions. Required in production.
PAYLOAD_SECRET=

# Where the SQLite database file lives. Default: ./content.db next to the app.
DATABASE_URI=file:./content.db

# Any long random string; protects the draft-preview URL (/api/draft).
PREVIEW_SECRET=

# Where uploaded images are written. Defaults to ./media next to the app; set
# this in containers so uploads land on a mounted volume instead of the image.
# MEDIA_DIR=
