# Build artifacts and deps; the image builds its own.
node_modules
.next
out
dist
coverage
*.tsbuildinfo

# Content lives in a mounted volume, never in the image.
content.db
content.db-shm
content.db-wal
media

# Secrets must come from the runtime environment.
.env
.env.*
!.env.production.example

# Not needed at build or run time.
.git
.gitignore
.github
.vscode
docs
Dockerfile
.dockerignore
docker-compose.yml
README.md
npm-debug.log*
.next-dev*.log
