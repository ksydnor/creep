# On the droplet:  cp .env.production.example .env
#
# It MUST be named exactly `.env`. Docker Compose reads only `.env` when
# expanding ${IMAGE} and ${PORT_BIND} in docker-compose.yml; a file named
# anything else is passed into the container but leaves those unresolved.
# This file holds live secrets; never commit it.

# Which image to run. DigitalOcean Container Registry or GHCR both work.
IMAGE=registry.digitalocean.com/<your-registry>/pari-portfolio:latest
# Builder-stage image, used only by the one-off seed service.
IMAGE_SEED=registry.digitalocean.com/<your-registry>/pari-portfolio:seed

# Signs admin login sessions. The app REFUSES TO START in production without it.
# Generate with:  openssl rand -base64 48
PAYLOAD_SECRET=

# Protects the draft-preview URL (/api/draft).
# Generate with:  openssl rand -base64 48
PREVIEW_SECRET=

# Where the app publishes. Loopback until something in front of it does HTTPS.
# PORT_BIND=127.0.0.1:3000

# Both default to the /data volume inside the image; override only if you
# remount it somewhere else.
# DATABASE_URI=file:/data/content.db
# MEDIA_DIR=/data/media
